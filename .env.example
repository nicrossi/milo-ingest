# DO NOT commit .env file!
# Copy this file to .env and fill in your desire values
POSTGRES_CONTAINER_NAME=milo-db-local
POSTGRES_USER=milo-admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=milo_dev
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIMENSION=384

# LocalStack Configuration
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# S3/SQS Configuration
INGEST_BUCKET=milo-raw-ingest-local
SQS_QUEUE_URL=http://localhost:4566/000000000000/milo-ingest-local
UPLOAD_PREFIX=uploads

# Database Configuration (for worker)
DB_NAME=milo_dev
DB_USERNAME=milo-admin
DB_PASSWORD=your_secure_password_here
DB_URL=postgresql://milo-admin:your_secure_password_here@localhost:5432/milo

# Upload Gateway Configuration
UPLOAD_GATEWAY_HOST=0.0.0.0
UPLOAD_GATEWAY_PORT=8010
UPLOAD_GATEWAY_ALLOW_ORIGIN=http://localhost:3000

# Environment
ENV=local